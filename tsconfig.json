{
    "compilerOptions": {
      "lib": ["es2017", "dom"],
      "target": "es2017",
      "outDir": "dist",
      "jsx": "react",
      "allowJs": true,
      "noUnusedLocals": true,
      "noUnusedParameters": true,
      "experimentalDecorators": true,
      "removeComments": true,
      "noImplicitAny": false,
      "moduleResolution": "node",
      "allowSyntheticDefaultImports": true,
      "types": ["@figma/plugin-typings"],
      "baseUrl": "./",
      "paths": {
        "@ui": ["src/app/ui/index.ts"],
        "@app/*": ["src/app/*"],
        "@src/*": ["src/*"]
      }
    },
    "include": ["**/*.ts", "**/*.tsx"],
    "exclude": ["node_modules"]
  }