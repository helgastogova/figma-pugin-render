{
  "type": "module",
  "name": "figma-plugin-render-components-sets",
  "version": "1.0.0",
  "description": "Figma plugin for Showcases render",
  "license": "ISC",
  "scripts": {
    "dev": "PORT=5000 rollup -c -w",
    "start": "sirv dist --port 5000",
    "rollup": "rollup -c",
    "lint": "eslint './{src,app}/**/*.{ts,tsx}'",
    "typecheck": "tsc --noEmit --skipLibCheck",
    "typecheck:watch": "tsc --noEmit --skipLibCheck --watch",
    "size": "size-limit",
    "prepare": "npm run rollup",
    "watch": "npm run build -- --watch"
  },
  "dependencies": {
    "classnames": "^2.5.1",
    "npm-check-updates": "^16.14.15",
    "openai": "^4.33.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "typograf": "^7.3.0"
  },
  "devDependencies": {
    "@babel/core": "^7.23.9",
    "@babel/plugin-transform-runtime": "^7.23.9",
    "@babel/preset-env": "^7.23.9",
    "@babel/preset-react": "^7.23.3",
    "@babel/runtime": "^7.23.9",
    "@figma/plugin-typings": "^1.87.0",
    "@rollup/plugin-alias": "^5.1.0",
    "@rollup/plugin-babel": "^6.0.4",
    "@rollup/plugin-commonjs": "^25.0.7",
    "@rollup/plugin-node-resolve": "^15.2.3",
    "@rollup/plugin-replace": "^5.0.5",
    "@rollup/plugin-typescript": "^11.1.6",
    "@svgr/rollup": "^8.1.0",
    "@types/react": "^18.2.55",
    "@types/react-dom": "^18.2.19",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "babel-loader": "^9.1.3",
    "edit-json-file": "^1.8.0",
    "eslint": "^8.56.0",
    "eslint-config-standard-with-typescript": "^43.0.1",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-n": "^16.6.2",
    "eslint-plugin-promise": "^6.1.1",
    "eslint-plugin-react": "^7.33.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "postcss": "^8.4.5",
    "prettier": "3.2.5",
    "rollup": "^2.60.0",
    "rollup-plugin-bundle-html-plus": "^1.4.0",
    "rollup-plugin-html-bundle": "^0.0.3",
    "rollup-plugin-livereload": "^2.0.5",
    "rollup-plugin-postcss": "^4.0.2",
    "rollup-plugin-scss": "^4.0.0",
    "rollup-plugin-terser": "^7.0.2",
    "sirv-cli": "^2.0.2",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=16.0.0",
    "npm": ">=7.0.0"
  }
}
